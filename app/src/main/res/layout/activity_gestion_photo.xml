<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GestionPhoto">

    <Button
        android:id="@+id/gp_ModifB2"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="28dp"
        android:text="@string/gph_addAcc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gp_supprB2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gph_takeB" />

    <Button
        android:id="@+id/gp_supprB2"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:layout_marginStart="71dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="28dp"
        android:text="@string/gph_supprAcc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gp_ModifB2"
        app:layout_constraintTop_toBottomOf="@+id/gph_takeB" />

    <Button
        android:id="@+id/gph_takeB"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:layout_marginTop="91dp"
        android:text="@string/gph_take"
        app:layout_constraintBottom_toTopOf="@+id/gp_ModifB2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gph_image" />

    <TextView
        android:id="@+id/gph_text"
        android:layout_width="298dp"
        android:layout_height="40dp"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="591dp"
        android:text="@string/gph_text"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <include
        layout="@layout/custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/gph_image"
        android:layout_width="325dp"
        android:layout_height="331dp"
        android:layout_marginTop="21dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gph_text"
        app:srcCompat="@android:drawable/screen_background_dark_transparent" />

    <TextView
        android:id="@+id/textViewOri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="45dp"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gp_supprB2"
        app:layout_constraintStart_toEndOf="@+id/gp_ModifB2"
        app:layout_constraintTop_toBottomOf="@+id/gph_takeB" />

    <ImageView
        android:id="@+id/gpp_boussole"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toTopOf="@+id/gph_takeB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gph_image"
        app:srcCompat="@drawable/compass_white" />

</androidx.constraintlayout.widget.ConstraintLayout>