<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GestionPhotosPiece">

    <include
        layout="@layout/custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/gpp_text"
        android:layout_width="298dp"
        android:layout_height="40dp"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="591dp"
        android:text="@string/gpp_text"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <ImageButton
        android:id="@+id/imageButtonN"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="25dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/imageButtonE"
        app:layout_constraintEnd_toStartOf="@+id/imageButtonS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gpp_text"
        app:srcCompat="@drawable/invisible" />

    <ImageButton
        android:id="@+id/imageButtonE"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/textE"
        app:layout_constraintEnd_toStartOf="@+id/imageButtonW"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageButtonN"
        app:srcCompat="@drawable/invisible" />

    <ImageButton
        android:id="@+id/imageButtonW"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="30dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/textW"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageButtonE"
        app:layout_constraintTop_toBottomOf="@+id/imageButtonS"
        app:srcCompat="@drawable/invisible" />

    <ImageButton
        android:id="@+id/imageButtonS"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="25dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/imageButtonW"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageButtonN"
        app:layout_constraintTop_toBottomOf="@+id/gpp_text"
        app:srcCompat="@drawable/invisible" />

    <TextView
        android:id="@+id/textN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="23dp"
        android:text="N"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/imageButtonE"
        app:layout_constraintEnd_toEndOf="@+id/imageButtonN"
        app:layout_constraintStart_toStartOf="@+id/imageButtonN"
        app:layout_constraintTop_toBottomOf="@+id/imageButtonN" />

    <TextView
        android:id="@+id/textS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="23dp"
        android:text="S"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/imageButtonW"
        app:layout_constraintEnd_toEndOf="@+id/imageButtonS"
        app:layout_constraintStart_toStartOf="@+id/imageButtonS"
        app:layout_constraintTop_toBottomOf="@+id/imageButtonS" />

    <TextView
        android:id="@+id/textE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="113dp"
        android:text="E"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageButtonE"
        app:layout_constraintStart_toStartOf="@+id/imageButtonE"
        app:layout_constraintTop_toBottomOf="@+id/imageButtonE" />

    <TextView
        android:id="@+id/textW"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="113dp"
        android:text="W"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageButtonW"
        app:layout_constraintStart_toStartOf="@+id/imageButtonW"
        app:layout_constraintTop_toBottomOf="@+id/imageButtonW" />

    <TextView
        android:id="@+id/gpp_textP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="22dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/imageButtonN"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gpp_text" />
</androidx.constraintlayout.widget.ConstraintLayout>