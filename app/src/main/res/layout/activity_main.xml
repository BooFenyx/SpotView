<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

  <include
      layout="@layout/custom_toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />


  <TextView
      android:id="@+id/textViewM2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="61dp"
      android:text="@string/ac_nm2"
      android:textSize="10sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/ac_chargerB"
      app:layout_constraintEnd_toEndOf="@+id/imageButtonM2"
      app:layout_constraintStart_toStartOf="@+id/imageButtonM2"
      app:layout_constraintTop_toBottomOf="@+id/imageButtonM2" />

  <Button
      android:id="@+id/ac_chargerB"
      android:layout_width="277dp"
      android:layout_height="49dp"
      android:layout_marginTop="543dp"
      android:layout_marginBottom="75dp"
      android:text="@string/ac_charger"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/toolbar" />

  <ImageButton
      android:id="@+id/imageButtonCreate"
      android:layout_width="100dp"
      android:layout_height="100dp"
      android:layout_marginStart="71dp"
      android:layout_marginTop="110dp"
      android:layout_marginEnd="16dp"
      android:layout_marginBottom="16dp"
      app:layout_constraintBottom_toTopOf="@+id/imageButtonM2"
      app:layout_constraintEnd_toStartOf="@+id/imageButtonM1"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/ac_text"
      app:srcCompat="@android:drawable/ic_menu_add" />

  <TextView
      android:id="@+id/textView5"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/ac_creer"
      android:textSize="10sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="@+id/imageButtonCreate"
      app:layout_constraintEnd_toEndOf="@+id/imageButtonCreate"
      app:layout_constraintHorizontal_bias="0.535"
      app:layout_constraintStart_toStartOf="@+id/imageButtonCreate"
      app:layout_constraintTop_toTopOf="@+id/imageButtonCreate"
      app:layout_constraintVertical_bias="0.848" />

  <ImageButton
      android:id="@+id/imageButtonM3"
      android:layout_width="100dp"
      android:layout_height="100dp"
      android:layout_marginStart="16dp"
      android:layout_marginTop="16dp"
      android:layout_marginEnd="71dp"
      android:layout_marginBottom="70dp"
      android:scaleType="centerInside"
      app:layout_constraintBottom_toTopOf="@+id/ac_chargerB"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/imageButtonM2"
      app:layout_constraintTop_toBottomOf="@+id/imageButtonM1"
      app:srcCompat="@android:drawable/ic_menu_add" />

  <ImageButton
      android:id="@+id/imageButtonM2"
      android:layout_width="100dp"
      android:layout_height="100dp"
      android:layout_marginStart="71dp"
      android:layout_marginTop="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginBottom="70dp"
      android:scaleType="centerInside"
      app:layout_constraintBottom_toTopOf="@+id/ac_chargerB"
      app:layout_constraintEnd_toStartOf="@+id/imageButtonM3"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/imageButtonCreate"
      app:srcCompat="@android:drawable/ic_menu_add" />

  <ImageButton
      android:id="@+id/imageButtonM1"
      android:layout_width="100dp"
      android:layout_height="100dp"
      android:layout_marginStart="16dp"
      android:layout_marginTop="110dp"
      android:layout_marginEnd="71dp"
      android:layout_marginBottom="16dp"
      android:scaleType="centerInside"
      app:layout_constraintBottom_toTopOf="@+id/imageButtonM3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/imageButtonCreate"
      app:layout_constraintTop_toBottomOf="@+id/ac_text"
      app:srcCompat="@android:drawable/ic_menu_add" />

  <TextView
      android:id="@+id/ac_text"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="124dp"
      android:layout_marginBottom="443dp"
      android:text="@string/ac_text"
      android:textAlignment="center"
      android:textSize="16sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/ac_chargerB"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <TextView
      android:id="@+id/textViewM1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="23dp"
      android:text="@string/ac_nm1"
      android:textSize="10sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/imageButtonM3"
      app:layout_constraintEnd_toEndOf="@+id/imageButtonM1"
      app:layout_constraintStart_toStartOf="@+id/imageButtonM1"
      app:layout_constraintTop_toBottomOf="@+id/imageButtonM1" />

  <TextView
      android:id="@+id/textViewM3"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="61dp"
      android:text="@string/ac_nm3"
      android:textSize="10sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/ac_chargerB"
      app:layout_constraintEnd_toEndOf="@+id/imageButtonM3"
      app:layout_constraintStart_toStartOf="@+id/imageButtonM3"
      app:layout_constraintTop_toBottomOf="@+id/imageButtonM3" />

</androidx.constraintlayout.widget.ConstraintLayout>
